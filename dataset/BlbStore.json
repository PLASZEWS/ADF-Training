{
	"name": "BlbStore",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureBlobStr",
			"type": "LinkedServiceReference"
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": {
					"value": "@concat('Incremental - ',pipeline().RunId,'.txt')",
					"type": "Expression"
				},
				"folderPath": "incremental_copy",
				"container": "datalake"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}