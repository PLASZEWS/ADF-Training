		{
			"name": "[concat(parameters('factoryName'), '/SCD2')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "src_employees",
								"type": "DatasetReference"
							},
							"name": "source1"
						},
						{
							"dataset": {
								"referenceName": "AzureSqlEmployeeDWH",
								"type": "DatasetReference"
							},
							"name": "Target"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "AzureSqlEmployeeDWH",
								"type": "DatasetReference"
							},
							"name": "Insert"
						},
						{
							"dataset": {
								"referenceName": "AzureSqlEmployeeDWH",
								"type": "DatasetReference"
							},
							"name": "Update"
						}
					],
					"transformations": [
						{
							"name": "RenameSomeColumns"
						},
						{
							"name": "lookup1"
						},
						{
							"name": "derivedColumn1"
						},
						{
							"name": "split1"
						},
						{
							"name": "alterRow1"
						},
						{
							"name": "alterRow2"
						}
					],
					"scriptLines": [
						"source(output(",
						"          emp_id as short,",
						"          first_name as string,",
						"          last_name as string,",
						"          DOB as date,",
						"          mobile as long,",
						"          gender as string,",
						"          address_street as string,",
						"          address_city as string,",
						"          entry_date as date,",
						"          store_id as short",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     inferDriftedColumnTypes: true,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source(output(",
						"          emp_id as integer,",
						"          emp_last_name as string,",
						"          city as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'Select emp_id,emp_last_name,city\\nfrom dbo.employeeDWH\\n',",
						"     format: 'query') ~> Target",
						"source1 select(mapColumn(",
						"          src_emp_id = emp_id,",
						"          src_first_name = first_name,",
						"          src_last_name = last_name,",
						"          src_DOB = DOB,",
						"          src_mobile = mobile,",
						"          src_gender = gender,",
						"          src_address_street = address_street,",
						"          src_address_city = address_city,",
						"          src_entry_date = entry_date,",
						"          src_store_id = store_id",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> RenameSomeColumns",
						"RenameSomeColumns, Target lookup(src_emp_id == emp_id,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> lookup1",
						"lookup1 derive(active = iif(isNull(emp_id), 'I', iif(src_last_name!=emp_last_name || src_address_city!=city,'U','R')),",
						"          i_end_date = toDate('9999-12-31'),",
						"          current = currentDate(),",
						"          u_ef_start_date = src_entry_date,",
						"          u_ef_end_date = subDays(src_entry_date,1),",
						"          de_created_date = currentTimestamp()) ~> derivedColumn1",
						"derivedColumn1 split(active=='I',",
						"     active=='U',",
						"     disjoint: false) ~> split1@(cinsert, cupdate)",
						"split1@cinsert alterRow(insertIf(active=='I'||active=='U')) ~> alterRow1",
						"split1@cupdate alterRow(updateIf(active=='U')) ~> alterRow2",
						"alterRow1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          emp_key as integer,",
						"          emp_id as integer,",
						"          emp_first_name as string,",
						"          emp_last_name as string,",
						"          DOB as date,",
						"          mobile as string,",
						"          gender as string,",
						"          address as string,",
						"          city as string,",
						"          created_date as date,",
						"          ef_start_date as date,",
						"          ef_end_date as date",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     saveOrder: 2,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          emp_id = src_emp_id,",
						"          emp_first_name = src_first_name,",
						"          emp_last_name = src_last_name,",
						"          DOB = src_DOB,",
						"          mobile = src_mobile,",
						"          gender = src_gender,",
						"          address = src_address_street,",
						"          city = src_address_city,",
						"          created_date = current,",
						"          ef_start_date = src_entry_date,",
						"          ef_end_date = i_end_date",
						"     )) ~> Insert",
						"alterRow2 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          emp_key as integer,",
						"          emp_id as integer,",
						"          emp_first_name as string,",
						"          emp_last_name as string,",
						"          DOB as date,",
						"          mobile as string,",
						"          gender as string,",
						"          address as string,",
						"          city as string,",
						"          created_date as date,",
						"          ef_start_date as date,",
						"          ef_end_date as date",
						"     ),",
						"     deletable:false,",
						"     insertable:false,",
						"     updateable:true,",
						"     upsertable:false,",
						"     keys:['emp_id'],",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     saveOrder: 1,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          emp_id = src_emp_id,",
						"          ef_end_date = u_ef_end_date",
						"     )) ~> Update"
					]
				}
			},
			"dependsOn": []
		},
