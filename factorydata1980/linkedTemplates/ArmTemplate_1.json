						"     broadcast: 'auto')~> lookup1",
						"lookup1 derive(active = iif(isNull(emp_key), 'I', iif(src_last_name!=emp_last_name || src_address_city!=city,'U','R')),",
						"          i_end_date = toDate('9999-12-31'),",
