		{
			"name": "[concat(parameters('factoryName'), '/GoldSalesOrderFact')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"linkedService": {
								"referenceName": "DataLake",
								"type": "LinkedServiceReference"
							},
							"name": "SourceSilver"
						},
						{
							"linkedService": {
								"referenceName": "DataLake",
								"type": "LinkedServiceReference"
							},
							"name": "SourceProduct"
						},
						{
							"linkedService": {
								"referenceName": "DataLake",
								"type": "LinkedServiceReference"
							},
							"name": "SourceFile"
						},
						{
							"linkedService": {
								"referenceName": "DataLake",
								"type": "LinkedServiceReference"
							},
							"name": "SourcePurchaseAddress"
						}
					],
					"sinks": [
						{
							"linkedService": {
								"referenceName": "DataLake",
								"type": "LinkedServiceReference"
							},
							"name": "sinkToGold"
						}
					],
					"transformations": [
						{
							"name": "joinProduct"
						},
						{
							"name": "joinSourceFile"
						},
						{
							"name": "joinPurchaseAddress"
						},
						{
							"name": "select1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          OrderID as integer,",
						"          Product as string,",
						"          QuantityOrdered as string,",
						"          PriceEach as float,",
						"          OrderDate as timestamp,",
						"          PurchaseAddress as string,",
						"          PurchaseCity as string,",
						"          State as string,",
						"          ZipCode as string,",
						"          LoadDate as date,",
						"          FileName as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet',",
						"     fileSystem: 'datalake',",
						"     wildcardPaths:['Silver/ProductDatabase']) ~> SourceSilver",
						"source(output(",
						"          Product as string,",
						"          PriceEach as float,",
						"          ProductID as long",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet',",
						"     fileSystem: 'datalake',",
						"     wildcardPaths:['Gold/ProductToDatabase/Product/Product.parquet']) ~> SourceProduct",
						"source(output(",
						"          FileName as string,",
						"          LoadDate as date,",
						"          FileSourceID as long",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet',",
						"     fileSystem: 'datalake',",
						"     wildcardPaths:['Gold/ProductToDatabase/FileSource']) ~> SourceFile",
						"source(output(",
						"          PurchaseAddress as string,",
						"          PurchaseCity as string,",
						"          State as string,",
						"          ZipCode as string,",
						"          PurchaseAddressID as long",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet',",
						"     fileSystem: 'datalake',",
						"     wildcardPaths:['Gold/ProductToDatabase/PurchaseAddress']) ~> SourcePurchaseAddress",
						"SourceSilver, SourceProduct join(SourceSilver@Product == SourceProduct@Product,",
						"     joinType:'left',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> joinProduct",
						"joinProduct, SourceFile join(SourceSilver@LoadDate == SourceFile@LoadDate",
						"     && SourceSilver@FileName == SourceFile@FileName,",
						"     joinType:'left',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> joinSourceFile",
						"joinSourceFile, SourcePurchaseAddress join(SourceSilver@PurchaseAddress == SourcePurchaseAddress@PurchaseAddress",
						"     && SourceSilver@PurchaseCity == SourcePurchaseAddress@PurchaseCity",
						"     && SourceSilver@State == SourcePurchaseAddress@State",
						"     && SourceSilver@ZipCode == SourcePurchaseAddress@ZipCode,",
						"     joinType:'left',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> joinPurchaseAddress",
						"joinPurchaseAddress select(mapColumn(",
						"          OrderID,",
						"          ProductID,",
						"          OrderDate,",
						"          QuantityOrdered,",
						"          FileSourceID,",
						"          PurchaseAddressID",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"select1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'parquet',",
						"     fileSystem: 'datalake',",
						"     folderPath: 'Gold/ProductToDatabase/SalesOrderFact',",
						"     truncate: true,",
						"     partitionFileNames:['SalesOrderFact.parquet'],",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> sinkToGold"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ProductDatabaseToBronze')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"linkedService": {
								"referenceName": "DataLake",
								"type": "LinkedServiceReference"
							},
							"name": "SourceRaw"
						}
					],
					"sinks": [
						{
							"linkedService": {
								"referenceName": "DataLake",
								"type": "LinkedServiceReference"
							},
							"name": "ProductDatabaseToBronze"
						}
					],
					"transformations": [
						{
							"name": "AddLoadDate"
						},
						{
							"name": "select1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          {Order ID} as string,",
						"          Product as string,",
						"          {Quantity Ordered} as string,",
						"          {Price Each} as string,",
						"          {Order Date} as string,",
						"          {Purchase Address} as string",
						"     ),",
						"     useSchema: false,",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     rowUrlColumn: 'FileName',",
						"     format: 'delimited',",
						"     fileSystem: 'datalake',",
						"     columnDelimiter: ',',",
						"     escapeChar: '\\\\',",
						"     quoteChar: '\\\"',",
						"     columnNamesAsHeader: true,",
						"     wildcardPaths:['Raw/Raw/ProductDatabase/*.csv']) ~> SourceRaw",
						"SourceRaw derive(LoadDate = currentDate()) ~> AddLoadDate",
						"AddLoadDate select(mapColumn(",
						"          OrderID = {Order ID},",
						"          Product,",
						"          QuantityOrdered = {Quantity Ordered},",
						"          PriceEach = {Price Each},",
						"          OrderDate = {Order Date},",
						"          PurchaseAddress = {Purchase Address},",
						"          FileName,",
						"          LoadDate",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"select1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'parquet',",
						"     fileSystem: 'datalake',",
						"     folderPath: 'Bronze/ProductDatabase',",
						"     truncate: true,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> ProductDatabaseToBronze"
					]
				}
			},
			"dependsOn": []
		},
