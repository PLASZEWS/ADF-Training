						{
							"name": "aggregate1"
						},
						{
							"name": "surrogateKey1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          OrderID as integer,",
						"          Product as string,",
						"          QuantityOrdered as string,",
						"          PriceEach as float,",
						"          OrderDate as timestamp,",
						"          PurchaseAddress as string,",
						"          PurchaseCity as string,",
						"          State as string,",
						"          ZipCode as string,",
						"          LoadDate as date,",
						"          FileName as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet',",
						"     fileSystem: 'datalake',",
						"     wildcardPaths:['Silver/ProductDatabase']) ~> sourceSilver",
