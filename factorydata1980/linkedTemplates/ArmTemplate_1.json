						"     LoadDate = last(LoadDate)) ~> aggregate1",
						"aggregate1 keyGenerate(output(FileSourceID as long),",
						"     startAt: 1L,",
						"     stepValue: 1L) ~> surrogateKey1",
						"surrogateKey1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'parquet',",
						"     fileSystem: 'datalake',",
						"     folderPath: 'Gold/ProductToDatabase/FileSource',",
						"     truncate: true,",
						"     partitionFileNames:['FileSource.parquet'],",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
