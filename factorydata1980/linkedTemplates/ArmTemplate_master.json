{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "factorydata1980"
		},
		"AzureBlobStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage1'"
		},
		"AzureSqlDataWarehouse_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDataWarehouse'"
		},
		"DataLake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'DataLake'"
		},
		"storageaccount_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'storageaccount'"
		},
		"AzureSqlDataWarehouse_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "kawdb1.database.windows.net"
		},
		"AzureSqlDataWarehouse_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "DataWarehouse"
		},
		"AzureSqlDataWarehouse_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "AdminPL"
		},
		"DataLake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storageaccountkaw1.dfs.core.windows.net/"
		},
		"storageaccount_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storageaccountkaw1.dfs.core.windows.net/"
		},
		"tumbling_trigger_properties_pipeline_parameters_startTime": {
			"type": "string",
			"defaultValue": "@trigger().outputs.windowStartTime"
		},
		"tumbling_trigger_properties_pipeline_parameters_endTime": {
			"type": "string",
			"defaultValue": "@trigger().outputs.windowEndTime"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "factorydata1980_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorage1_connectionString": {
						"value": "[parameters('AzureBlobStorage1_connectionString')]"
					},
					"AzureSqlDataWarehouse_password": {
						"value": "[parameters('AzureSqlDataWarehouse_password')]"
					},
					"DataLake_accountKey": {
						"value": "[parameters('DataLake_accountKey')]"
					},
					"storageaccount_accountKey": {
						"value": "[parameters('storageaccount_accountKey')]"
					},
					"AzureSqlDataWarehouse_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDataWarehouse_properties_typeProperties_server')]"
					},
					"AzureSqlDataWarehouse_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDataWarehouse_properties_typeProperties_database')]"
					},
					"AzureSqlDataWarehouse_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDataWarehouse_properties_typeProperties_userName')]"
					},
					"DataLake_properties_typeProperties_url": {
						"value": "[parameters('DataLake_properties_typeProperties_url')]"
					},
					"storageaccount_properties_typeProperties_url": {
						"value": "[parameters('storageaccount_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "factorydata1980_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"tumbling_trigger_properties_pipeline_parameters_startTime": {
						"value": "[parameters('tumbling_trigger_properties_pipeline_parameters_startTime')]"
					},
					"tumbling_trigger_properties_pipeline_parameters_endTime": {
						"value": "[parameters('tumbling_trigger_properties_pipeline_parameters_endTime')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'factorydata1980_ArmTemplate_0')]"
			]
		}
	]
}