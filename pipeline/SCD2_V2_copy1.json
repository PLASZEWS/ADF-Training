{
	"name": "SCD2_V2_copy1",
	"properties": {
		"activities": [
			{
				"name": "Lookup1",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "source_employees",
						"type": "DatasetReference",
						"parameters": {
							"folder": {
								"value": "@concat('employees',formatDateTime(utcNow(),'yyyy-mm-dd'))",
								"type": "Expression"
							},
							"filename": "Employee.txt"
						}
					},
					"firstRowOnly": false
				}
			}
		],
		"annotations": []
	}
}