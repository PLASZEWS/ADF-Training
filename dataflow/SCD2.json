{
	"name": "SCD2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "DataLake",
						"type": "LinkedServiceReference"
					},
					"name": "SourceEemp"
				},
				{
					"linkedService": {
						"referenceName": "AzureSqlDataWarehouse",
						"type": "LinkedServiceReference"
					},
					"name": "DimEmp"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "lookup1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          EmpID as short,",
				"          Region as string,",
				"          Status as string,",
				"          Function as string,",
				"          Level as string,",
				"          Role as string,",
				"          StartDate as date 'dd/MM/yyyy',",
				"          EndDate as date 'dd/MM/yyyy'",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     fileSystem: 'datalake',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true,",
				"     wildcardPaths:['Source/*.txt']) ~> SourceEemp",
				"source(output(",
				"          EmpID as integer,",
				"          Region as string,",
				"          Status as string,",
				"          EmpFunction as string,",
				"          Level as string,",
				"          Role as string,",
				"          StartDate as date,",
				"          EndDate as date,",
				"          iscurrent as short,",
				"          processtime as binary",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'EmpDim',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> DimEmp",
				"SourceEemp lookup(ERROR_FUNCTION('') == ERROR_FUNCTION(''),",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1"
			]
		}
	}
}